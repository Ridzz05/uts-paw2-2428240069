              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Studio tersimpan dan id disimpan\", () => { const b = pm.response.json(); pm.expect(b.data.kode).to.eql(\"ST-2428240069\"); pm.environment.set(\"studioId\", b.data._id); });"
